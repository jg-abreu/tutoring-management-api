# Run http/auth.http first to store the tokens.

@baseUrl = http://localhost:8080

### 1. Tutor suggests a subject -> 201 PENDING
POST {{baseUrl}}/subjects
Content-Type: application/json
Authorization: Bearer {{tutorToken}}

{
  "subjectName": "Physics I"
}

> {% client.global.set("subjectUuid", response.body.id); %}

### 2. The same name again -> 409
POST {{baseUrl}}/subjects
Content-Type: application/json
Authorization: Bearer {{student1Token}}

{
  "subjectName": "Physics I"
}

### 3. Blank name -> 400
POST {{baseUrl}}/subjects
Content-Type: application/json
Authorization: Bearer {{student1Token}}

{
  "subjectName": ""
}

### 4. student1 (regular user) tries to approve the subject -> 403
PATCH {{baseUrl}}/subjects/{{subjectUuid}}/approve
Authorization: Bearer {{student1Token}}

### 5. A regular user gets 403 even for a subject that does not exist (no 404 leak)
PATCH {{baseUrl}}/subjects/00000000-0000-0000-0000-000000000000/approve
Authorization: Bearer {{student1Token}}

### 6. Admin approves the subject -> APPROVED
PATCH {{baseUrl}}/subjects/{{subjectUuid}}/approve
Authorization: Bearer {{adminToken}}

### 7. Approving it again -> 409
PATCH {{baseUrl}}/subjects/{{subjectUuid}}/approve
Authorization: Bearer {{adminToken}}

### 8. student1 suggests another subject and the admin rejects it -> REJECTED
POST {{baseUrl}}/subjects
Content-Type: application/json
Authorization: Bearer {{student1Token}}

{
  "subjectName": "Chemistry I"
}

> {% client.global.set("rejectedSubjectUuid", response.body.id); %}

###
PATCH {{baseUrl}}/subjects/{{rejectedSubjectUuid}}/reject
Authorization: Bearer {{adminToken}}

### 9. Any user lists every subject by name
GET {{baseUrl}}/subjects
Authorization: Bearer {{student1Token}}

### 10. Only the approved subjects
GET {{baseUrl}}/subjects?status=APPROVED
Authorization: Bearer {{student1Token}}

### 11. One subject by id
GET {{baseUrl}}/subjects/{{subjectUuid}}
Authorization: Bearer {{student1Token}}

### 12. A subject that does not exist -> 404
GET {{baseUrl}}/subjects/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{student1Token}}
